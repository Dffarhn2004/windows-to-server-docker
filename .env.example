# COPY TO .env (never commit it). Example domains only; replace them.
ROOT_DOMAIN=example.com
HELLO_HOST=hello.example.com
STATUS_HOST=status.example.com
# Public dashboard names. Change example.com when the real domain is ready.
WAHA_HOST=waha-admin.example.com
ROUTER_HOST=ai.example.com

# Cloudflare Zero Trust > Networks > Tunnels > Your Tunnel > Install Connector
# Keep this token private. Do not include quotes or surrounding whitespace.
TUNNEL_TOKEN=REPLACE_WITH_YOUR_CLOUDFLARE_TUNNEL_TOKEN

# Optional WAHA stack (do not start before replacing every secret)
WAHA_IMAGE_TAG=latest-2026.10.1
WAHA_API_KEY=REPLACE_WITH_STRONG_RANDOM_API_KEY
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

# Optional 9Router stack (do not start before replacing every secret)
ROUTER_IMAGE_TAG=0.5.112
ROUTER_JWT_SECRET=REPLACE_WITH_RANDOM_HEX_64
ROUTER_API_KEY_SECRET=REPLACE_WITH_RANDOM_HEX_64
ROUTER_MACHINE_ID_SALT=REPLACE_WITH_RANDOM_HEX_32
ROUTER_INITIAL_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

# Optional database stack (database/data services are NOT started by default)
POSTGRES_IMAGE_TAG=17-alpine
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_DB_PASSWORD
REDIS_IMAGE_TAG=7.4-alpine
REDIS_PASSWORD=REPLACE_WITH_STRONG_RANDOM_REDIS_PASSWORD
